# FeastFlow Environment Configuration Example

# Server Port (Default: 3000)
PORT=3000

# Node Environment (development / production)
NODE_ENV=development

# Application Base URL (Used for generating tracking links)
APP_BASE_URL=http://localhost:5000

# MongoDB Connection String
# Leave empty or unconfigured to automatically use the embedded MongoDB Memory Server for local dev
MONGODB_URI=

# JWT Authentication Secret Key
JWT_SECRET=feastflow_jwt_secret_key_2026

# WhatsApp Cloud API Webhook Verification Token
WHATSAPP_VERIFY_TOKEN=feastflow_verify_token_2026
